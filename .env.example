# Página neutra del botón "Salir"
NEXT_PUBLIC_URL_SALIDA=https://www.google.com

# --- Zoho CRM (sin ZOHO_REFRESH_TOKEN el formulario corre en modo prueba y NO guarda nada) ---
ZOHO_CLIENT_ID=
ZOHO_CLIENT_SECRET=
ZOHO_REFRESH_TOKEN=
ZOHO_ACCOUNTS_URL=https://accounts.zoho.com
ZOHO_API_DOMAIN=https://www.zohoapis.com

# --- Enlace único por participante ---
# Secreto para firmar los enlaces (cadena larga aleatoria)
ZOHO_LINK_SECRET=
# Clave que Zoho usa para pedir un enlace a /api/enlace (cadena larga aleatoria, distinta de la anterior)
ENLACE_API_KEY=
# Dirección pública del formulario, sin "/" final
URL_FORMULARIO=
# Días de vigencia del enlace (opcional, por defecto 7, máximo 30)
# ENLACE_DIAS=7

# --- Solo mientras se prueba (quitar en producción) ---
# 1 = permite abrir el formulario SIN enlace y crea un registro nuevo
# PERMITIR_SIN_ENLACE=1
# 1 = muestra en pantalla el código de error de Zoho
# MOSTRAR_DETALLE_ERROR=1
