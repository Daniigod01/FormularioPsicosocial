# Página neutra del botón "Salir"
NEXT_PUBLIC_URL_SALIDA=https://www.google.com

# --- Zoho CRM (sin ZOHO_REFRESH_TOKEN el formulario corre en modo prueba y NO guarda nada) ---
ZOHO_CLIENT_ID=
ZOHO_CLIENT_SECRET=
ZOHO_REFRESH_TOKEN=
# Según el centro de datos de la cuenta Zoho (por defecto .com):
ZOHO_ACCOUNTS_URL=https://accounts.zoho.com
ZOHO_API_DOMAIN=https://www.zohoapis.com
# Secreto compartido para firmar el enlace único de cada participante (cadena larga y aleatoria)
ZOHO_LINK_SECRET=

# Solo mientras se prueba: muestra en pantalla el código de error de Zoho (poner 1). Quitar en producción.
# MOSTRAR_DETALLE_ERROR=1
